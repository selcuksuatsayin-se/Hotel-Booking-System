{
  "Routes": [

    {
      // --- ÖZEL ROTA: My Reservations (Çakışmayı önlemek için) ---
      "DownstreamPathTemplate": "/api/v1/Reservations/MyReservations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5152
        }
      ],
      "UpstreamPathTemplate": "/hotel-service/api/v1/Reservations/MyReservations",
      "UpstreamHttpMethod": [ "GET" ],
      "DangerousAcceptAnyServerCertificateValidator": true
    },

    {
      // --- 1. SEARCH SERVICE (Search Controller - Filtreleme) ---
      // Frontend "/hotel-service/api/v1/Search" dediğinde buraya
      "DownstreamPathTemplate": "/api/v1/Search",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5067
        }
      ],
      "UpstreamPathTemplate": "/hotel-service/api/v1/Search",
      "UpstreamHttpMethod": [ "GET" ],
      "DangerousAcceptAnyServerCertificateValidator": true
    },
    {
      // --- 2. SEARCH SERVICE (Hotels Controller - Listeleme/Detay) ---
      // Frontend "/hotel-service/api/v1/Hotels" dediğinde buraya
      "DownstreamPathTemplate": "/api/v1/Hotels/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5067
        }
      ],
      "UpstreamPathTemplate": "/hotel-service/api/v1/Hotels/{everything}",
      "UpstreamHttpMethod": [ "GET" ],
      "DangerousAcceptAnyServerCertificateValidator": true
    },
    {
      // Hotels kök dizin garantisi
      "DownstreamPathTemplate": "/api/v1/Hotels",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5067
        }
      ],
      "UpstreamPathTemplate": "/hotel-service/api/v1/Hotels",
      "UpstreamHttpMethod": [ "GET" ],
      "DangerousAcceptAnyServerCertificateValidator": true
    },
    {
      // --- 3. BOOKING SERVICE (Rezervasyon İşlemleri) ---
      "DownstreamPathTemplate": "/api/v1/Reservations/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5152
        }
      ],
      "UpstreamPathTemplate": "/hotel-service/api/v1/Reservations/{everything}",
      "UpstreamHttpMethod": [ "POST", "GET" ],
      "DangerousAcceptAnyServerCertificateValidator": true
    },
    {
      // Booking kök dizin garantisi
      "DownstreamPathTemplate": "/api/v1/Reservations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5152
        }
      ],
      "UpstreamPathTemplate": "/hotel-service/api/v1/Reservations",
      "UpstreamHttpMethod": [ "POST", "GET" ],
      "DangerousAcceptAnyServerCertificateValidator": true
    },
    {
      // --- 4. ADMIN SERVICE (Yönetim İşlemleri) ---
      // POST, PUT, DELETE işlemleri Admin Service'e gider
      "DownstreamPathTemplate": "/api/v1/Hotels/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5161
        }
      ],
      "UpstreamPathTemplate": "/hotel-service/api/v1/Hotels/{everything}",
      "UpstreamHttpMethod": [ "POST", "PUT", "DELETE" ],
      "DangerousAcceptAnyServerCertificateValidator": true
    },
    {
      // --- 5. ADMIN SERVICE (YENİ: Müsaitlik & Fiyat Güncelleme) ---
      // BulkUpdate işlemi buraya düşecek
      "DownstreamPathTemplate": "/api/v1/Availability/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5161
        }
      ],
      "UpstreamPathTemplate": "/hotel-service/api/v1/Availability/{everything}",
      "UpstreamHttpMethod": [ "POST", "PUT", "GET" ],
      "DangerousAcceptAnyServerCertificateValidator": true
    },

    {
      // --- 5. ML PREDICTION SERVICE (Fiyat Tahmini) ---
      "DownstreamPathTemplate": "/predict",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/hotel-service/api/v1/Prediction",
      "UpstreamHttpMethod": [ "POST" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5292",
    "DangerousAcceptAnyServerCertificateValidator": true
  }
}