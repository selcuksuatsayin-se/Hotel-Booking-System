{
  "Routes": [
    {
      // Route 1: Hotel Service (Everything starting with /api/v1/...)
      "DownstreamPathTemplate": "/api/v1/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "hotel-admin-selcuk-cehtg2cfgte8axdv.canadacentral-01.azurewebsites.net",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/hotel-service/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },
    {
      // Route 2: ML Service (Prediction)
      // Note: Assuming you will deploy Python app to Azure later. 
      // For now, you can point this to localhost if running locally, or skip until Python is deployed.
      "DownstreamPathTemplate": "/predict",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/ml-service/predict",
      "UpstreamHttpMethod": [ "POST" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7000"
  }
}